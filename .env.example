DATABASE_URL=file:./data/grokbott.sqlite
MASTER_ENCRYPTION_KEY=
# Opcional: modo in-process (sem relay externo)
XAI_API_KEY=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Produção: https://seu-dominio.com  (obrigatório HTTPS)
# COOKIE_SECURE=true

# ManyTalks — instância (configure uma vez; o painel usa isso em todos os GrokBots)
MANYTALKS_BASE=https://app.manytalks.com.br

# OBRIGATÓRIO para operar: PAT do agente/admin (Perfil → Access Token)
# Lista accounts via /api/v1/profile, inboxes, mensagens, kanban, webhooks
MANYTALKS_SERVICE_TOKEN=

# Opcional: Platform App (Applications → Platform App). Nesta instância
# GET /platform/api/v1/accounts retorna 404; agent_bots funciona.
MANYTALKS_PLATFORM_TOKEN=

# Agente ManyTalks padrão (atribuição + webhooks "atribuída a mim")
DEFAULT_MANYTALKS_ASSIGNEE_ID=775

# Teste local antes de produção: pnpm test:probes (account/inbox alvo)
INTEGRATION_TEST_ACCOUNT_ID=41
INTEGRATION_TEST_INBOX_ID=571
# INTEGRATION_TEST_GROKBOT_ID=  # opcional: força um bot; senão acha pelo account+inbox

# OpenCode CLI — Playbook (modelos free só via CLI: npm i -g @opencode/cli)
# Auth: opencode auth login (Connect provider → OpenCode Console)
# OPENCODE_BIN=
# 1 modelo = mais rápido; vários = fallback se free limitar
OPENCODE_FREE_MODELS=minimax-m3.1-flash-free,deepseek-v4.1-flash-free,glm-5.3-flash-free
# OPENCODE_API_KEY=

