{
  "name": "manytalks-bot-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev --turbopack\" \"tsx scripts/worker.ts\"",
    "dev:web": "next dev --turbopack",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:all": "concurrently -k -n web,worker -c cyan,magenta \"pnpm start\" \"pnpm worker\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/manifest/*.test.ts src/lib/manytalks/*.test.ts src/lib/admin/*.test.ts src/lib/runtime/*.test.ts",
    "test:probes": "tsx scripts/test-integration-probes.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup-sqlite.ts",
    "worker": "tsx scripts/worker.ts",
    "test:pattern-scan": "tsx scripts/test-pattern-scan.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "jose": "^6.0.10",
    "lucide-react": "^0.477.0",
    "next": "^15.2.2",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2"
  }
}
